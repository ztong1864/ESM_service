# Copy to .env and edit. Both run_local.ps1 and docker compose read this file.
# Every setting has a working default; an empty .env is fine.

# Where the .pt files are (default: ./models; the container uses /app/models).
#ESM_MODELS_DIR=

# Loaded at startup and used when a request names no model.
#ESM_SERVICE_DEFAULT_MODEL=esm2-35m

# auto (GPU when torch sees one), cpu, or cuda.
#ESM_SERVICE_DEVICE=auto

# Load the default model at startup, so the first request does not wait for it.
#ESM_SERVICE_PRELOAD=true

# How many models stay in memory at once. esm2-650m is about 2.6 GB.
#ESM_SERVICE_MAX_LOADED_MODELS=1

# How many requests may be scored at the same time.
#ESM_SERVICE_MAX_CONCURRENCY=2

# torch intra-op threads; 0 leaves torch's default (usually every core).
#ESM_SERVICE_TORCH_THREADS=0

# Made-up numbers, no model: for checking the API without torch. Never on in production.
#ESM_SERVICE_MOCK=false

# Largest accepted FASTA/GenBank text, in bytes (a protein record is a few KB).
#ESM_SERVICE_MAX_RECORD_BYTES=2097152
